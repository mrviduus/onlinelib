# Flat node_modules, not pnpm's symlinked default.
#
# Metro resolves modules by walking real directories, and React Native's Gradle
# autolinking reads node_modules directly; both have a long history of breaking
# on pnpm's symlink layout. Hoisting gives them the npm-shaped tree they expect
# while the workspace and its catalog still do the version management.
node-linker=hoisted
