{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "EXPO_PUBLIC_API_URL=http://localhost:8083/api expo start --web",
    "proxy": "node proxy.js",
    "web:dev": "node proxy.js & EXPO_PUBLIC_API_URL=http://localhost:8083/api expo start --web; kill %1",
    "build:dev": "eas build --profile development --platform all",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform all",
    "build:prod": "eas build --profile production --platform all",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "update": "eas update",
    "test:e2e": "npx playwright test --config=e2e/playwright.config.ts --project=android",
    "test:e2e:ios": "npx playwright test --config=e2e/playwright.config.ts --project=ios",
    "test:e2e:ui": "npx playwright test --config=e2e/playwright.config.ts --project=android --ui"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "expo": "~55.0.9",
    "expo-apple-authentication": "~55.0.9",
    "expo-asset": "^55.0.10",
    "expo-clipboard": "~55.0.9",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "~55.0.19",
    "expo-document-picker": "~55.0.9",
    "expo-font": "~55.0.4",
    "expo-image": "~55.0.6",
    "expo-image-picker": "~55.0.14",
    "expo-linking": "~55.0.9",
    "expo-notifications": "~55.0.14",
    "expo-router": "~55.0.8",
    "expo-secure-store": "~55.0.9",
    "expo-speech": "~55.0.9",
    "expo-splash-screen": "~55.0.13",
    "expo-sqlite": "~55.0.11",
    "expo-status-bar": "~55.0.4",
    "react": "19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "@playwright/test": "^1.52.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
