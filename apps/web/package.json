{
  "name": "textstack-web",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:ssg": "tsc && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "build:mobile-overlay": "node scripts/build-mobile-overlay.mjs",
    "build:mobile-pdf": "node scripts/build-mobile-pdf.mjs",
    "check:mobile-overlay": "node scripts/check-mobile-overlay.mjs",
    "check:mobile-pdf": "node scripts/check-mobile-pdf.mjs",
    "bench:reader-overlay": "node scripts/bench-reader-overlay.mjs"
  },
  "dependencies": {
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.3",
    "pdfjs-dist": "4.10.38",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@prerenderer/renderer-puppeteer": "^1.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.0",
    "jsdom": "^28.1.0",
    "pg": "^8.20.0",
    "puppeteer": "^24.43.1",
    "typescript": "~5.6.3",
    "vite": "^6.4.2",
    "vite-plugin-prerender": "^1.0.8",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "puppeteer"
    ]
  }
}
