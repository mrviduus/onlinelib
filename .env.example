# .env.example
# Copy to .env and fill in values

# Database
POSTGRES_USER=textstack_prod
POSTGRES_PASSWORD=<secure-password>
POSTGRES_DB=textstack_prod

# JWT
JWT_SECRET=<min-32-char-secret>
JWT_ISSUER=textstack.app
JWT_AUDIENCE=textstack.app

# Google OAuth
GOOGLE_CLIENT_ID=<google-client-id>

# Environment
ASPNETCORE_ENVIRONMENT=Production

# Search (postgres or meilisearch)
SEARCH_PROVIDER=postgres
MEILI_MASTER_KEY=

# IndexNow (Bing/Yandex instant indexing)
INDEXNOW_KEY=
INDEXNOW_ENABLED=false

# Resend (email: password reset + admin ops alerts)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@textstack.app
# Where SEO backfill / ops failure alerts go. Empty = alerts disabled.
ADMIN_ALERT_EMAIL=

# ─── UI feature flags (default OFF → production ships clean) ───
# Web (Vite) — set in apps/web/.env.local
# VITE_FEATURE_BLOG=true
# VITE_FEATURE_MOODS=true
# VITE_FEATURE_REVIEWS=true
# VITE_FEATURE_AMBIENT_SOCIAL=true

# Admin (Vite) — set in apps/admin/.env.local
# VITE_FEATURE_BOARD_TASKS=true   # Kanban task board admin page

# Mobile (Expo) — set in apps/mobile/.env.local or EAS secrets
# EXPO_PUBLIC_FEATURE_BLOG=true
# EXPO_PUBLIC_FEATURE_MOODS=true
# EXPO_PUBLIC_FEATURE_REVIEWS=true
# EXPO_PUBLIC_FEATURE_AMBIENT_SOCIAL=true
