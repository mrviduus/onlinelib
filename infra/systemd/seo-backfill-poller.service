[Unit]
Description=TextStack SEO Backfill Poller
After=docker.service
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory=/home/vasyl/projects/onlinelib/textstack
ExecStart=/home/vasyl/projects/onlinelib/textstack/infra/scripts/seo-backfill-poll.sh
Restart=on-failure
RestartSec=10
Environment=HOME=/home/vasyl
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=API_URL=http://localhost:8080

[Install]
WantedBy=default.target
