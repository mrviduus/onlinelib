{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=books;Username=app;Password=changeme"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "textstack.app;textstack.dev;localhost;*.localhost;api",
  "Jwt": {
    "SecretKey": "",
    "Issuer": "textstack.app",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30,
    "GuestRefreshTokenExpiryDays": 30
  },
  "Google": {
    "ClientId": ""
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4.1-nano",
    "Embedding": {
      "Model": "text-embedding-3-small"
    },
    "Translate": {
      "MaxTextLength": 500
    }
  },
  "Eval": {
    "JudgeModel": "gpt-4.1"
  },
  "Translate": {
    "CachePath": "data/translate-cache",
    "CacheTtlDays": 30
  },
  "Explain": {
    "MaxWordLength": 100,
    "MaxSentenceLength": 800,
    "CachePath": "data/explain-cache",
    "CacheTtlDays": 30
  },
  "Tts": {
    "CachePath": "data/tts-cache",
    "MaxTextLength": 500,
    "TimeoutSeconds": 15
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "gemma4:e2b",
    "TimeoutSeconds": 90
  },
  "LLM": {
    "DefaultProvider": "openai",
    "Providers": {
      "Explain": "openai",
      "Translate": "openai",
      "Distractor": "ollama",
      "BookMetadata": "ollama",
      "TagSuggestion": "ollama"
    }
  },
  "Ai": {
    "DefaultProvider": "openai",
    "Routes": {
      "explain": "openai",
      "translate": "openai",
      "distractor": "ollama",
      "bookmeta": "ollama",
      "tagsuggestion": "ollama",
      "podcast.script": "openai"
    },
    "Tracing": {
      "Sampling": {
        "Default": 1.0,
        "PerFeature": {
          "explain": 0.1,
          "translate": 0.1
        }
      }
    }
  },
  "FileUpload": {
    "MaxBookSizeMb": 100,
    "MaxCoverSizeMb": 5,
    "MaxPhotoSizeMb": 2
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://general.localhost",
      "http://general.localhost:5173",
      "http://localhost:81",
      "http://admin.localhost",
      "http://admin.localhost:81",
      "https://textstack.app",
      "https://textstack.dev"
    ]
  }
}
