{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=books;Username=app;Password=changeme"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "textstack.app;textstack.dev;localhost;*.localhost;api",
  "Jwt": {
    "SecretKey": "",
    "Issuer": "textstack.app",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30,
    "GuestRefreshTokenExpiryDays": 30
  },
  "Google": {
    "ClientId": ""
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4.1-nano",
    "Explain": {
      "Model": "gpt-4.1-mini"
    },
    "RagAsk": {
      "Model": "gpt-4.1-mini"
    },
    "Embedding": {
      "Model": "text-embedding-3-small"
    },
    "Translate": {
      "MaxTextLength": 500
    }
  },
  "Eval": {
    "JudgeModel": "gpt-4.1",
    "Scheduled": {
      "__comment": "OFF by default; spends judge $ when enabled (ContinuousEvalWorker, slice 5a).",
      "Enabled": false,
      "CheckIntervalHours": 1,
      "IntervalHours": 24,
      "Features": [ "explain" ],
      "RegressionDrop": 0.5,
      "DailyBudgetUsd": 0
    }
  },
  "Drift": {
    "__comment": "OFF by default; spends embedding $ when enabled (DriftDetectionWorker, slice 5b).",
    "Enabled": false,
    "CheckIntervalHours": 1,
    "IntervalHours": 24,
    "Features": [ "explain" ],
    "MaxSampleSize": 50,
    "MinSampleSize": 10,
    "Threshold": 0.15,
    "ConsecutiveDays": 2,
    "BaselineWindowDays": 7
  },
  "Translate": {
    "CachePath": "data/translate-cache",
    "CacheTtlDays": 30
  },
  "Explain": {
    "MaxWordLength": 100,
    "MaxSentenceLength": 800,
    "CachePath": "data/explain-cache",
    "CacheTtlDays": 30
  },
  "Tts": {
    "CachePath": "data/tts-cache",
    "MaxTextLength": 500,
    "TimeoutSeconds": 15
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "gemma4:e2b",
    "TimeoutSeconds": 90
  },
  "LLM": {
    "DefaultProvider": "openai",
    "Providers": {
      "Explain": "openai",
      "Translate": "openai",
      "Distractor": "ollama",
      "BookMetadata": "ollama",
      "TagSuggestion": "ollama"
    }
  },
  "Ai": {
    "DefaultProvider": "openai",
    "Routes": {
      "explain": "openai-explain",
      "explain.toolcall": "openai-explain",
      "translate": "openai",
      "distractor": "ollama",
      "bookmeta": "ollama",
      "bookmeta.agent": "openai-explain",
      "tagsuggestion": "ollama",
      "podcast.script": "openai",
      "rag.ask": "openai-rag"
    },
    "Tracing": {
      "Sampling": {
        "Default": 1.0,
        "PerFeature": {
          "explain": 0.1,
          "translate": 0.1
        }
      }
    },
    "_ShadowComment": "Shadow routing is OFF by default: shadow makes PAID background LLM calls. Enable per-feature by adding a Routes entry (feature -> shadow provider key, e.g. 'openai-explain') AND a SampleRates entry (feature -> 0..1). Default:SampleRate applies to any routed feature without an explicit SampleRates entry.",
    "Shadow": {
      "Default": {
        "SampleRate": 0.0
      },
      "Routes": {},
      "SampleRates": {},
      "TimeoutSeconds": 15
    },
    "_BudgetsComment": "Per-feature daily (UTC) USD budget. OFF by default (Default:Mode=off + empty Features). Enable per feature: Features:{feature}:{DailyUsd (>0), Fallback (cheaper provider key, e.g. 'ollama'), Mode ('fallback'|'hardstop')}. fallback reroutes over budget; hardstop returns HTTP 429. Spend is process-local + UTC-daily, lazy-seeded from sampled llm_traces on restart (approximate).",
    "Budgets": {
      "Default": {
        "Mode": "off"
      },
      "Features": {}
    }
  },
  "FileUpload": {
    "MaxBookSizeMb": 100,
    "MaxCoverSizeMb": 5,
    "MaxPhotoSizeMb": 2
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://general.localhost",
      "http://general.localhost:5173",
      "http://localhost:81",
      "http://admin.localhost",
      "http://admin.localhost:81",
      "https://textstack.app",
      "https://textstack.dev"
    ]
  }
}
