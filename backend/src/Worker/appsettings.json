{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4.1-nano",
    "Explain": {
      "Model": "gpt-4.1-mini"
    },
    "Embedding": {
      "Model": "text-embedding-3-small"
    }
  },
  "Enrichment": {
    "_comment": "AI-Agent-1: the book-metadata Enrichment agent commits a field once its calibrated confidence reaches this threshold; otherwise it keeps cross-checking or emits 'unknown'.",
    "ConfidenceThreshold": 0.7
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "gemma4:e2b",
    "TimeoutSeconds": 90
  },
  "LLM": {
    "DefaultProvider": "ollama",
    "Providers": {
      "Distractor": "ollama",
      "BookMetadata": "ollama",
      "TagSuggestion": "ollama"
    }
  },
  "Ai": {
    "DefaultProvider": "ollama",
    "Routes": {
      "distractor": "ollama",
      "bookmeta": "ollama",
      "bookmeta.agent": "openai-explain",
      "tagsuggestion": "ollama",
      "podcast.script": "openai"
    },
    "Tracing": {
      "Sampling": {
        "Default": 1.0
      }
    }
  }
}
